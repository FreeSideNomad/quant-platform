# Copy to .env.local and fill in. .env.secrets holds real credentials and is gitignored.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://quant:replace-me@localhost:5432/quant

# --- Object storage (MinIO locally, GCS in prod) ---
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=quant-bronze
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Upstream OIDC (mock locally; Google Workspace or Microsoft Entra in prod) ---
OIDC_UPSTREAM_DISCOVERY_URL=http://localhost:9800/.well-known/openid-configuration
OIDC_UPSTREAM_CLIENT_ID=quant-platform
OIDC_UPSTREAM_CLIENT_SECRET=mock-secret
OIDC_UPSTREAM_NAME=mock

# --- Our federation IdP ---
IDP_ISSUER=http://localhost:8001
IDP_INTERNAL_URL=http://idp:8001
IDP_CLIENT_ID=quant-bff
IDP_CLIENT_SECRET=dev-bff-secret
# IDP_SIGNING_KEY_B64 omitted — dev generates an ephemeral keypair at idp startup
IDP_SIGNING_KEY_ID=qp-dev-1
IDP_ACCESS_TOKEN_TTL_SECONDS=900
IDP_REFRESH_TOKEN_TTL_SECONDS=1209600
IDP_TOKEN_AUDIENCE=quant-platform

# --- BFF (browser-facing reverse proxy) ---
BFF_PUBLIC_URL=http://localhost:8080
BFF_UPSTREAM_API_URL=http://api:8000
BFF_SESSION_IDLE_SECONDS=1800
BFF_SESSION_ABSOLUTE_SECONDS=28800
BFF_SESSION_COOKIE_SECURE=false
# 32 bytes base64 for AES-256-GCM; generate with: openssl rand -base64 32
BFF_TOKEN_ENCRYPTION_KEY_B64=dev-replace-me-with-openssl-rand-base64-32+padpadpadpadpad=

# --- Back-compat ---
SESSION_JWT_SIGNING_KEY=dev-only-not-a-real-key-replace-in-prod

# --- Role selection at container startup ---
# api | worker-proj-ui | worker-training | scheduler | bridge-pgmq-http
ROLE=api

# --- Logging ---
LOG_LEVEL=INFO
