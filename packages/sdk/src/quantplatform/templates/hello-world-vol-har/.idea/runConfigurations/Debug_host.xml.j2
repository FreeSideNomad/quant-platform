<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Debug strategy (host)" type="PythonConfigurationType" factoryName="Python">
    <module name="{{ name }}" />
    <option name="SCRIPT_NAME" value="$PROJECT_DIR$/src/{{ name.replace('-', '_') }}/strategy.py" />
    <envs>
      <env name="PQ_DATABASE_URL" value="postgresql://qp:qp@localhost:15432/qp" />
      <env name="PQ_MLFLOW_TRACKING_URI" value="http://localhost:15000" />
      <env name="PQ_S3_ENDPOINT_URL" value="http://localhost:19000" />
      <env name="PQ_S3_ACCESS_KEY" value="minioadmin" />
      <env name="PQ_S3_SECRET_KEY" value="minioadmin" />
      <env name="AWS_ACCESS_KEY_ID" value="minioadmin" />
      <env name="AWS_SECRET_ACCESS_KEY" value="minioadmin" />
      <env name="MLFLOW_S3_ENDPOINT_URL" value="http://localhost:19000" />
    </envs>
  </configuration>
</component>
