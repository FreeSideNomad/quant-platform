[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description or "HAR-style realized-variance forecast" }}"
requires-python = ">=3.12"
dependencies = [
  # Pre-M8 (no PyPI publish): pull quantplatform from the public GitHub repo.
  # During in-flight milestones, ref points at the feature branch that hasn't
  # merged yet. The M3-merge commit will flip this to `@main`. After M8 the
  # whole thing becomes a plain "quantplatform" PyPI dep.
  "quantplatform @ git+https://github.com/FreeSideNomad/quant-platform.git@feat/m3-sdk-local-runs#subdirectory=packages/sdk",
  "lightgbm>=4.5",
  "polars-lts-cpu>=1.8",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.metadata]
# Required so `hatch build` accepts direct-URL dependencies like the git+https above.
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ name.replace('-', '_') }}"]

[dependency-groups]
dev = [
  "pytest>=8.3",
  "numpy>=2.0",
  "ruff>=0.7",
  "pyright>=1.1.380",
]
