[project]
name = "{{ name }}"
entry = "{{ name.replace('-', '_') }}.strategy:main"

[thresholds]
pbo_max = 0.5
dsr_probability_min = 0.95
walk_forward_min_folds = 8

[data]
# MVP: only the bundled AAPL daily dataset is available (CC0 source —
# see apps/api/data/PROVENANCE.md). Register additional datasets with
# `pq data register` (M4+).
datasets = ["ohlcv-aapl-daily/v1"]
