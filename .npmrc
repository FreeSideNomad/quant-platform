# pnpm needs to install optional native bindings (rolldown, esbuild, lightningcss)
# for every (os, cpu, libc) tuple we might run on — otherwise installs done on
# macOS don't have the Linux binding baked into the lockfile and Linux CI fails
# with "Cannot find module '@rolldown/binding-linux-x64-gnu'".
node-linker=hoisted
auto-install-peers=true
package-manager-strict=false
supported-architectures[os][0]=linux
supported-architectures[os][1]=darwin
supported-architectures[cpu][0]=x64
supported-architectures[cpu][1]=arm64
supported-architectures[libc][0]=glibc
supported-architectures[libc][1]=musl
