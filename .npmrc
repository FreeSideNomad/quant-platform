# pnpm default (symlinked) node_modules layout — rolldown's native binding
# loader uses `require('@rolldown/binding-linux-x64-gnu')` which resolves
# correctly through pnpm's nested symlinks. Using `node-linker=hoisted`
# here *broke* that lookup: the optional binding was never installed into
# node_modules because hoisted mode filters differently. Leaving node-linker
# at its default (isolated/symlinked) fixes it.
auto-install-peers=true
package-manager-strict=false
