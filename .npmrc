# pnpm default (symlinked) layout. `supported-architectures` forces pnpm to
# resolve AND install optional native bindings for every (os, cpu, libc)
# tuple listed — without this, Linux CI installs skip
# `@rolldown/binding-linux-x64-gnu` even though it's listed as an
# optionalDependency in the lockfile, and vitest startup fails with
# "Cannot find module '@rolldown/binding-linux-x64-gnu'".
auto-install-peers=true
package-manager-strict=false
supported-architectures[os][0]=linux
supported-architectures[os][1]=darwin
supported-architectures[cpu][0]=x64
supported-architectures[cpu][1]=arm64
supported-architectures[libc][0]=glibc
supported-architectures[libc][1]=musl
